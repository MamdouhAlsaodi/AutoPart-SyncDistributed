{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Graphite workshop, copper hardware and diagnostic teal for an academic auto-parts prototype.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.149,
          0.188
        ],
        "hex": "#172630"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.318,
          0.408,
          0.463
        ],
        "hex": "#516876"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.733,
          0.31,
          0.102
        ],
        "hex": "#bb4f1a"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.933,
          0.949,
          0.937
        ],
        "hex": "#eef2ef"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.996,
          0.98
        ],
        "hex": "#fffefa"
      }
    },
    "copper-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.902,
          0.639,
          0.369
        ],
        "hex": "#e6a35e"
      }
    },
    "teal": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.29,
          0.769,
          0.843
        ],
        "hex": "#4ac4d7"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 800
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
