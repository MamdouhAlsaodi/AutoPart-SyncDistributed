# Copie para .env e ajuste localmente; nunca versione o arquivo .env.
MONGODB_URI=mongodb://127.0.0.1:27017/autopart_sync
PORT=3000
# Gere independentemente uma chave longa, aleatória e privada; este valor é apenas um placeholder.
JWT_SECRET=gere_uma_chave_aleatoria_longa_e_unica
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# Caminho local acadêmico explícito (opt-in deliberado; não é o padrão):
# 1. Copie este arquivo para .env.
# 2. Substitua JWT_SECRET por um valor privado gerado independentemente.
# 3. Para avaliar deliberadamente a carga local, defina:
#    SEED_DEMO_DATA=true
#    SEED_DEMO_PASSWORD=AutoPartDemo2026!
# AutoPartDemo2026! é uma senha pública acadêmica somente para a demonstração local,
# não é JWT_SECRET e não deve ser usada em produção.
